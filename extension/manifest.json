{
  "manifest_version": 3,
  "name": "Senseek · Semantic Page Search",
  "short_name": "Senseek",
  "version": "1.2.0",
  "description": "Find what you mean. Search the current page by meaning and highlight the source with your own TypeSafe/JEV API key.",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Senseek · Find what you mean.",
    "default_icon": {
      "16": "icons/icon-16-8e922a8e9e7a.png",
      "32": "icons/icon-32-8f4eb3da132d.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Open / close Senseek"
    }
  },
  "icons": {
    "16": "icons/icon-16-8e922a8e9e7a.png",
    "32": "icons/icon-32-8f4eb3da132d.png",
    "48": "icons/icon-48-44978ed1d0ef.png",
    "128": "icons/icon-128-88a0d149389f.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://api.typesafe.ai;"
  }
}
